{
  "name": "developing-with-docker",
  "version": "1.0.0",
  "description": "A minimal Node.js/Express profile editor with a vanilla JS frontend that persists profile updates to MongoDB. The project is intended for practicing containerization and Compose orchestration.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#app/node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\" \"#app/node_modules\"",
    "format": "prettier --write \"**/*.md\" \"!node_modules\" \"!app/node_modules\"",
    "format:check": "prettier --check \"**/*.md\" \"!node_modules\" \"!app/node_modules\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dthangerCColl/developing-with-docker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dthangerCColl/developing-with-docker/issues"
  },
  "homepage": "https://github.com/dthangerCColl/developing-with-docker#readme",
  "lint-staged": {
    "*.md": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "markdownlint-cli2": "^0.19.1",
    "prettier": "^3.8.4"
  }
}
